VITE_APP_TITLE=用户中心

# 是否启用 Mock（true 时接口走内置 mock-api，无需后端即可登录）
VITE_APP_MOCK=true

# 真实后端接口基地址（经 vite proxy 转发到 VITE_API_TARGET）。
# 注意：开启 Mock 时（VITE_APP_MOCK=true）会自动改用 /mock-api/v1，无需手动改这里。
VITE_API_BASE_URL=/api/v1

# 真实后端 Go/Gin 服务地址（关闭 Mock 时生效）
VITE_API_TARGET=http://localhost:9981

# localStorage 键前缀
VITE_APP_STORAGE_PREFIX=my_dev

# www 完整 API 文档（Scalar）地址。
# 同源部署（www 在根、my 在 /my/）默认 /api-docs 即可；
# 跨域部署时填完整地址，如 https://www.example.com/api-docs。
VITE_DOCS_URL=/api-docs
