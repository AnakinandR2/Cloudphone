VITE_APP_TITLE=管理后台

# 是否启用 Mock（true 时接口走内置 mock-api，无需后端即可登录）
VITE_APP_MOCK=false

# 真实后端接口基地址（经 vite proxy 转发到 VITE_API_TARGET）。
# 注意：开启 Mock 时（VITE_APP_MOCK=true）会自动改用 /mock-api/v1，无需手动改这里。
VITE_API_BASE_URL=/api/v1

# 真实后端 Go/Gin 服务地址（关闭 Mock 时生效）
VITE_API_TARGET=http://localhost:9981

# localStorage 键前缀
VITE_APP_STORAGE_PREFIX=admin_dev

# 小西通行证（SSO）配置
VITE_SSO_PROJECT_ID=e7srvvcy
VITE_SSO_LOGIN_URL=https://sso.xiaoxitech.com/login
