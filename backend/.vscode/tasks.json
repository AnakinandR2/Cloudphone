{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "generate swagger docs",
            "type": "shell",
            "command": "~/go/bin/swag",
            "args": [
                "init",
                "-g",
                "main.go",
                "--output",
                "./docs"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "presentation": {
                "reveal": "silent",
                "panel": "shared",
                "close": true
            },
            "problemMatcher": []
        }
    ]
}

